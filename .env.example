# === Обязательное ===
# Токен бота от @BotFather
BOT_TOKEN=

# Канал: @username (для публичного) или id вида -100xxxxxxxxxx (для приватного)
CHANNEL_ID=

# Ключ Gemini из https://aistudio.google.com (бесплатно)
GEMINI_API_KEY=

# === Необязательное (дефолты подходят большинству) ===
GEMINI_MODEL=gemini-3.8-flash
# Как часто проверять источники (минуты, только для демон-режима на ПК/VPS)
CHECK_INTERVAL_MINUTES=30
# Максимум постов в день
DAILY_QUOTA=5
# Минимальный перерыв между постами (минуты)
MIN_POST_GAP_MINUTES=150
# Окно постинга по местному времени канала
POST_WINDOW_START_HOUR=10
POST_WINDOW_END_HOUR=23
TIMEZONE=Europe/Moscow
# true = не постить новости без фото
REQUIRE_IMAGE=true
# Google News как источник (недоступен с российских IP, на зарубежном VPS оставить true)
GOOGLE_NEWS_ENABLED=true
# Новости старше N часов не постятся
MAX_CANDIDATE_AGE_HOURS=48
